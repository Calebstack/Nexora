{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build",
    "start": "node init && next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,mjs,ts}\"",
    "clean": "node -e \"for (const dir of ['.next', 'out']) require('node:fs').rmSync(dir, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.9.9",
    "typescript": "^5"
  }
}
