{
  "name": "@lumen-nexora/nexora",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Nexora payment API",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:cjs": "node init && tsc -p tsconfig.cjs.json",
    "build:esm": "node init && tsc -p tsconfig.esm.json",
    "build:types": "node init && tsc -p tsconfig.types.json",
    "build": "node init && npm run build:cjs && npm run build:esm && npm run build:types",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "clean": "rm -rf dist",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "nexora",
    "payments",
    "stellar",
    "usdc",
    "fintech",
    "sdk"
  ]
}
